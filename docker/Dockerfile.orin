# Policy client — Jetson Orin NX onboard the G1
# (JetPack 5.1.1, L4T R35.3.1, aarch64, sm_87, Ubuntu 20.04, Python 3.8).
#
# BUILD THIS ON AN aarch64 HOST. The tag must match the device's L4T exactly:
# the CUDA and driver userspace are mounted from the host at runtime, so a
# different tag fails on the robot even though it builds fine.
#
#   docker build -f docker/Dockerfile.orin -t <registry>/manipurl-orin:<tag> .
#
# The client does no inference -- it moves images and actions -- so nothing here
# needs CUDA. l4t-jetpack is the tag the organizer's README names for the Orin;
# BASE_IMAGE=nvcr.io/nvidia/l4t-base:r35.3.1 builds a much smaller image if the
# organizer confirms the lighter tag is acceptable.
#
# The Orin has 16 GB of UNIFIED memory shared with the GPU, so keeping this
# image and this process small is a constraint, not tidiness.
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r35.3.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# numpy and OpenCV come from apt so they stay the ABI-matched pair Ubuntu built:
# a pip numpy 2.x next to an apt cv2 compiled against numpy 1.x imports and then
# fails at the first array crossing between them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-numpy python3-opencv \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements-orin.txt /tmp/requirements-orin.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir -r /tmp/requirements-orin.txt

# libgomp is built with static TLS, and on aarch64 the surplus reserved for
# that is small. cv2 pulls libgomp in through dlopen, i.e. after the initial
# load set has already claimed the surplus, and the import dies with
#
#   ImportError: libgomp.so.1: cannot allocate memory in static TLS block
#
# Preloading moves it into the initial load set, where the reservation is made.
# The boundary imports cv2 to decode camera JPEGs, so without this the client
# does not start at all -- not just conformance.
ENV LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1
RUN if [ ! -f "$LD_PRELOAD" ]; then \
        echo "libgomp is not at $LD_PRELOAD in this base image; the real path is:"; \
        ldconfig -p | grep libgomp || echo "  (not found at all)"; \
        exit 1; \
    fi \
    && python3 -c "import cv2, numpy, zmq, msgpack, websockets; print('cv2', cv2.__version__, '| numpy', numpy.__version__, '| websockets', websockets.__version__)"

WORKDIR /submission
# boundary/ is copied exactly as the organizer ships it. Only components/ is ours.
COPY boundary/ /submission/boundary/
COPY components/ /submission/components/
COPY mocks/ /submission/mocks/
# 52 KB of joint origins. The client never runs FK, but conformance.py
# starts the server in-process, and that does.
COPY assets/ /submission/assets/
COPY scripts/ /submission/scripts/
COPY docs/boundary.sha256 /submission/docs/boundary.sha256
COPY conformance.py requirements.txt /submission/
COPY docker/entrypoint_orin.sh /usr/local/bin/entrypoint_orin.sh
RUN chmod +x /usr/local/bin/entrypoint_orin.sh

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/submission
ENV PEVAL_LANE=decoupled
ENV PEVAL_THOR_HOST=192.168.100.1
ENV PEVAL_THOR_PORT=8765

# We BIND :5556 and the organizer's controller dials in. :5555 and :5557 are
# outbound subscriptions, so they are not exposed here.
EXPOSE 5556
ENTRYPOINT ["/usr/local/bin/entrypoint_orin.sh"]
CMD ["python3", "components/client.py", "--lane", "decoupled"]
